# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API from a browser (admin, website)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────
# docker compose up -d postgres  →  postgresql://laundry:laundry@localhost:5433/laundry_dev
DATABASE_URL=postgresql://laundry:laundry@localhost:5433/laundry_dev

# ── Business ─────────────────────────────────────────────
APP_NAME=IronDost
# Prefix for human-facing order numbers, e.g. LD001042
ORDER_NUMBER_PREFIX=ID

# ── Firebase (phone OTP + push only) ─────────────────────
# Service account JSON, base64-encoded:  base64 -i service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Development only: accept "Bearer dev:<phone>" tokens instead of Firebase ID tokens.
# Never enable in production; the API refuses to start if NODE_ENV=production.
AUTH_DEV_BYPASS=false

# ── Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Tests ──────────────────────────────────────────────
# Server the e2e suite connects to for creating its throwaway database
# TEST_DATABASE_SERVER_URL=postgresql://postgres@localhost:5432/postgres

# ── Image uploads ────────────────────────────────────────
# local: files saved under STORAGE_LOCAL_DIR and served by the API at /uploads (development only)
# s3:    files saved to S3_BUCKET; STORAGE_PUBLIC_BASE_URL is the bucket or CloudFront URL.
#        For Supabase Storage also set S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3, S3_REGION to the
#        project's region, and put the Supabase S3 access key pair in AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
#        AWS credentials come from the standard chain (IAM role, env vars or profile).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=

# ── Bootstrap ────────────────────────────────────────────
# Phone number of the first super admin, created by the seed script (E.164)
SEED_SUPER_ADMIN_PHONE=+919000000000
