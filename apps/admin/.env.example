# API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Firebase web config for phone-OTP sign-in (Firebase console → Project settings → Your apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local development only: "Sign in without code" using the API's dev tokens.
# Requires AUTH_DEV_BYPASS=true on the API. Never enable in production.
NEXT_PUBLIC_AUTH_DEV_BYPASS=false
