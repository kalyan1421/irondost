<?xml version="1.0" encoding="utf-8"?>
<!-- Shown from process start until Flutter draws its first frame. Matches the app's own launch screen:
     the logo with its tagline, centred, on the surface colour (light or dark). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
