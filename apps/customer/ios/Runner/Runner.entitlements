<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. Xcode swaps this to "production" for App Store and TestFlight builds. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links: irondost.in/get, /offers, /o/<orderId>, /r/<code> open the app. Verified against
	     https://irondost.in/.well-known/apple-app-site-association (see docs/deep-links.md). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:irondost.in</string>
		<string>applinks:www.irondost.in</string>
	</array>
</dict>
</plist>
